# Maintainer: OmaCalendar contributors
pkgname=omacalendar-bin
pkgver=@PROJECT_VERSION@
pkgrel=1
pkgdesc='Local-first calendar for Omarchy Linux (prebuilt)'
arch=('x86_64')
url='https://github.com/brdweb/omacalendar'
license=('MIT')
depends=(
  'git'
  'hicolor-icon-theme'
  'libical'
  'libsecret'
  'python'
  'qt6-base'
  'qt6-declarative'
  'qt6-networkauth'
  'qt6-wayland'
)
provides=("omacalendar=${pkgver}")
conflicts=('omacalendar')
source_x86_64=("${pkgname}-${pkgver}.tar.zst::${url}/releases/download/v${pkgver}/omacalendar-${pkgver}-linux-x86_64.tar.zst")
sha256sums_x86_64=('@BINARY_SHA256@')

package() {
  cp -a usr "${pkgdir}/"
  install -Dm644 "${pkgdir}/usr/share/doc/OmaCalendar/LICENSE" \
    "${pkgdir}/usr/share/licenses/omacalendar/LICENSE"
}
