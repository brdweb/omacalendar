{
  "app-id": "org.omacalendar.OmaCalendar",
  "runtime": "org.kde.Platform",
  "runtime-version": "6.10",
  "sdk": "org.kde.Sdk",
  "command": "omacalendar",
  "branch": "stable",
  "build-options": {
    "libdir": "/app/lib",
    "prepend-pkg-config-path": "/app/lib/pkgconfig",
    "strip": true,
    "no-debuginfo": true
  },
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri",
    "--talk-name=org.freedesktop.secrets",
    "--talk-name=org.freedesktop.Notifications",
    "--nofilesystem=xdg-config/kdeglobals",
    "--no-talk-name=com.canonical.AppMenu.Registrar",
    "--no-talk-name=org.kde.kconfig.notify",
    "--no-talk-name=org.kde.KGlobalSettings",
    "--env=QT_QPA_PLATFORMTHEME=xdgdesktopportal"
  ],
  "cleanup": [
    "/include",
    "/lib/cmake",
    "/lib/pkgconfig",
    "/lib/systemd",
    "/share/aclocal",
    "/share/gir-1.0",
    "/share/gtk-doc",
    "/share/man",
    "*.a",
    "*.la"
  ],
  "modules": [
    {
      "name": "libical",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DCMAKE_INSTALL_LIBDIR=lib",
        "-DBUILD_SHARED_LIBS=ON",
        "-DLIBICAL_BUILD_DOCS=OFF",
        "-DLIBICAL_BUILD_TESTING=OFF",
        "-DLIBICAL_GLIB=OFF",
        "-DLIBICAL_JAVA_BINDINGS=OFF",
        "-DLIBICAL_BUILD_EXAMPLES=OFF"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/libical/libical/releases/download/v4.0.5/libical-4.0.5.tar.gz",
          "sha256": "cc09a3ac41d60e6144e644bd3fcf97d47106d659c4a0b8965102581401e67c9c"
        }
      ],
      "post-install": [
        "install -Dm644 LICENSES/LGPL-2.1-only.txt /app/share/licenses/libical/LGPL-2.1-only.txt",
        "install -Dm644 LICENSES/MPL-2.0.txt /app/share/licenses/libical/MPL-2.0.txt"
      ]
    },
    {
      "name": "libsecret",
      "buildsystem": "meson",
      "config-opts": [
        "--libdir=lib",
        "-Dgtk_doc=false",
        "-Dintrospection=false",
        "-Dvapi=false",
        "-Dmanpage=false",
        "-Dbash_completion=disabled"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://download.gnome.org/sources/libsecret/0.21/libsecret-0.21.7.tar.xz",
          "sha256": "6b452e4750590a2b5617adc40026f28d2f4903de15f1250e1d1c40bfd68ed55e"
        }
      ],
      "post-install": [
        "install -Dm644 ../COPYING /app/share/licenses/libsecret/COPYING"
      ]
    },
    {
      "name": "omacalendar",
      "buildsystem": "simple",
      "secret-env": [
        "OMACALENDAR_BUILD_GOOGLE_CLIENT_ID",
        "OMACALENDAR_BUILD_GOOGLE_CLIENT_SECRET",
        "OMACALENDAR_FLATPAK_VERSION_SUFFIX",
        "OMACALENDAR_FLATPAK_REQUIRE_GOOGLE"
      ],
      "build-commands": [
        "cmake -S . -B _flatpak_build -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/app -DCMAKE_INSTALL_LIBDIR=lib -DOMACALENDAR_BUILD_TESTS=OFF -DOMACALENDAR_VERSION_SUFFIX=\"$OMACALENDAR_FLATPAK_VERSION_SUFFIX\" -DOMACALENDAR_REQUIRE_GOOGLE_OAUTH_CONFIG=\"${OMACALENDAR_FLATPAK_REQUIRE_GOOGLE:-ON}\"",
        "cmake --build _flatpak_build --parallel ${FLATPAK_BUILDER_N_JOBS:-2}",
        "cmake --install _flatpak_build",
        "install -d /app/libexec/omacalendar",
        "mv /app/bin/omacalendar /app/libexec/omacalendar/omacalendar-ui",
        "install -m 755 packaging/flatpak/omacalendar-launcher /app/bin/omacalendar",
        "rm /app/bin/omacalendar-widgetctl"
      ],
      "sources": []
    }
  ]
}
